//! name: wrap_as_truncates
//! rule: 03.R6
//! expect: run-ok
//! detail: ok

module m;
needs { io.stdout };
use std.io;

fn main(inout out: io.Stdout) {
    var x: u32 = 300;
    var y: u8 = x.wrap_as[u8]();
    if y == 44u8 {
        out.write_line("ok");
    } else {
        out.write_line("fail");
    }
}
