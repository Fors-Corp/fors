//! name: reduce_shape_reference_n1
//! rule: 03.R11
//! expect: run-ok
//! detail: ok  -- tree(n=1) = 1.0

module m;
needs { io.stdout };

fn main(inout out: io.Stdout) {
    var data: Array[f64, 1] = [1.0];
    let xs: Slice[f64] = data[0 ..< 1];   // ch03 Rule 24
    var r: f64 = reduce(-, xs);
    if r == 1.0 {
        out.write_line("ok");
    } else {
        out.write_line("fail");
    }
}
