//! name: reduce_shape_reference_n1
//! rule: 03.R11
//! expect: run-ok
//! detail: ok  -- tree(n=1) = 1.0

module m;
needs { io.stdout };

fn main(sink w: World) {
    var out: io.Writer = move w.stdout;
    var xs: Slice[f64] = [1.0];
    var r: f64 = reduce(-, xs);
    if r == 1.0 {
        out.write_line("ok");
    } else {
        out.write_line("fail");
    }
}
