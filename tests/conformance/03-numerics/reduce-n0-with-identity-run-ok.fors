//! name: reduce_empty_with_identity
//! rule: 03.R11a
//! expect: run-ok
//! detail: ok

module m;
needs { io.stdout };

fn main(inout out: io.Stdout) {
    var data: Array[f64, 0] = [];
    let xs: Slice[f64] = data[0 ..< 0];   // ch03 Rule 24
    var r: f64 = reduce(+, xs, identity: 0.0);
    if r == 0.0 {
        out.write_line("ok");
    } else {
        out.write_line("fail");
    }
}
