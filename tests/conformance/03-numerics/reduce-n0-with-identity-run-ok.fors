//! name: reduce_empty_with_identity
//! rule: 03.R11a
//! expect: run-ok
//! detail: ok

module m;
needs { io.stdout };

fn main(sink w: World) {
    var out: io.Writer = move w.stdout;
    var xs: Slice[f64] = [];
    var r: f64 = reduce(+, xs, identity: 0.0);
    if r == 0.0 {
        out.write_line("ok");
    } else {
        out.write_line("fail");
    }
}
