//! name: sat_as_clamps
//! rule: 03.R6
//! expect: run-ok
//! detail: ok

module m;
needs { io.stdout };

fn main(sink w: World) {
    var out: io.Writer = move w.stdout;
    var x: i32 = 300;
    var y: u8 = x.sat_as[u8]();
    if y == 255u8 {
        out.write_line("ok");
    } else {
        out.write_line("fail");
    }
}
