//! name: wrap_add_never_traps
//! rule: 03.R4
//! expect: run-ok
//! detail: ok

module m;
needs { io.stdout };
use std.io;

fn main(inout out: io.Stdout) {
    var x: i32 = 2147483647;
    var y: i32 = 1;
    var z: i32 = x.wrap_add(y);
    if z == -2147483648 {
        out.write_line("ok");
    } else {
        out.write_line("fail");
    }
}
