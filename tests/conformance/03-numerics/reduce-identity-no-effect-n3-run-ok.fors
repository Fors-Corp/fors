//! name: reduce_identity_does_not_alter_nonempty_result
//! rule: 03.R11a
//! expect: run-ok
//! detail: ok

module m;
needs { io.stdout };

fn main(inout out: io.Stdout) {
    var data: Array[f64, 3] = [1.0; 3];
    let xs: Slice[f64] = data[0 ..< 3];   // ch03 Rule 24
    var r1: f64 = reduce(-, xs);
    var r2: f64 = reduce(-, xs, identity: 999.0);
    if r1 == r2 {
        out.write_line("ok");
    } else {
        out.write_line("fail");
    }
}
