//! name: errdefer_consumes_on_error_exit_accepted
//! rule: 01.R23b
//! expect: check-ok
//! detail: ch01 R23b, R23d(b) -- `errdefer` runs on the error exits only, so the normal exit is free to `return move r;`

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f() -> Res raises Err {
    var r: Res = Res.open(1);
    errdefer r.close();
    r.step()?;
    return move r;
}
