//! name: defer_question_inside_rejected
//! rule: 01.R23c
//! expect: check-error
//! detail: ch01 R23c (ch09 T0033) -- a deferred body MUST NOT contain `?`; a call to a `raises` function needs an `else |e| { }` handler instead

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f() raises Err {
    var r: Res = Res.open(1);
    defer { r.step()?; r.close(); }
}
