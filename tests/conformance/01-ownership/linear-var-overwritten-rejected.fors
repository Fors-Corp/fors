//! name: linear_var_overwritten_rejected
//! rule: 01.R22h
//! expect: check-error
//! detail: ch01 R22h -- the assignment overwrites an unconsumed value

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f() {
    var r: Res = Res.open(1);
    r = Res.open(2);
    r.close();
}
