//! name: defer_place_moved_before_exit_rejected
//! rule: 01.R23d
//! expect: check-error
//! detail: ch01 R23d(a) -- `r` is moved at 18:5 but the `defer` at 17:5 still needs it

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f() {
    var r: Res = Res.open(1);
    defer r.close();
    r.close();
}
