//! name: brand_param_two_arenas_rejected
//! rule: 01.R15d
//! expect: check-error
//! detail: one call to `touch[A: brand]` passes an `Arena` of brand `two` and a `Ref` of brand `one` for the same parameter `A`

needs { };

struct Node[A: brand] { val: i64 }

fn touch[A: brand](inout a: Arena[Node[A], A], let r: Ref[Node[A], A]) {
    let v: i64 = a[r].val;
}

fn use_it() {
    with arena one: Arena[Node[one]] {
        let x: Ref[Node[one], one] = one.alloc(Node { val: 1 });
        with arena two: Arena[Node[two]] {
            touch(&two, x);
        }
    }
}
