//! name: errdefer_after_fallible_call_rejected
//! rule: 01.R23b
//! expect: check-error
//! detail: ch01 R23b, R22h -- the `errdefer` at 18:5 can never run (no error exit follows it), and `r` is not consumed on the path leaving `f`'s body at the `?` at 17:5

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f() raises Err {
    var r: Res = Res.open(1);
    r.step()?;
    errdefer r.close();
    r.close();
}
