//! name: errdefer_and_defer_interleaved_reverse_order_accepted
//! rule: 01.R23b
//! expect: check-ok
//! detail: ch01 R23b -- `defer` and `errdefer` bodies pending in one block run interleaved, in ONE reverse textual order

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f() raises Err {
    var r: Res = Res.open(1);
    var q: Res = Res.open(2);
    defer r.close();
    errdefer q.close();
    r.step()?;
    q.close();
}
