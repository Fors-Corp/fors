//! name: linear_spawn_move_accepted
//! rule: 01.R22g
//! expect: check-ok
//! detail: ch01 R22g, R13 -- a structured `spawn` consumes by `move`; the callee's `sink` parameter carries the obligation inside the task

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn own(sink r: iso Res) { r.close(); }

fn f() {
    var r: iso Res = Res.open(1);
    spawn own(move r);
}
