//! name: linear_with_block_defer_accepted
//! rule: 01.R22g
//! expect: check-ok
//! detail: ch01 R22g, R23d(f) -- the allocator binding is live for its own block's deferred bodies, so `defer` inside the block is the idiom

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f() {
    with allocator a: PageAllocator {
        var r: Res = Res.open(1);
        defer r.close();
        r.poke();
    }
}
