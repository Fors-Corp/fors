//! name: linear_in_loop_reinit_accepted
//! rule: 01.R22d
//! expect: check-ok
//! detail: ch01 R4a(b) -- the place is re-initialised on every path to the next iteration, and consumed in the body

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f(let n: usize) {
    for i in 0 ..< n {
        var r: Res = Res.open(1);
        r.close();
    }
}
