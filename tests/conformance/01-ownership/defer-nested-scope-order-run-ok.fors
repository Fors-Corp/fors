//! name: defer_nested_scope_order_run_ok
//! rule: 01.R23a
//! expect: run-ok
//! detail: inner\nouter  -- R23a: leaving the inner block runs its pending bodies first; the exit then continues into the enclosing block, whose bodies run next

module app;
needs { io.stdout };
use std.io;

fn main(inout out: io.Stdout) {
    defer out.write_line("outer");
    {
        defer out.write_line("inner");
    }
}
