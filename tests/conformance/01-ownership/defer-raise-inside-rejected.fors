//! name: defer_raise_inside_rejected
//! rule: 01.R23c
//! expect: check-error
//! detail: ch01 R23c (ch09 T0033) -- a deferred body MUST NOT contain `raise`: a second error would have to replace the first or be lost

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn poke(inout self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f() raises Err {
    defer { raise Err.boom; }
}
