//! name: error-exit-through-nested-blocks
//! rule: 02.R16
//! expect: check-ok
//! detail: ch02 R16 -- the error passes through every block between the raise site and the function body, so all three are left by ERROR exits and each runs its `errdefer` bodies

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
    fn step(let self) raises Err { }
}
enum Err { boom }

fn f(let n: usize) raises Err {
    with allocator a: PageAllocator {
        var outer: Res = Res.open(1);
        errdefer outer.close();
        for i in 0 ..< n {
            var inner: Res = Res.open(2);
            errdefer inner.close();
            inner.step()?;
            inner.close();
        }
        outer.close();
    }
}
