//! name: sealed_holder_package_must_be_named
//! rule: 04.R2b
//! expect: check-error
//! detail: package `vendor` holding ffi with no manifest entry naming it must be diagnosed at the needs clause
//! manifest:
//! [capabilities.ffi]
//! packages = ["std"]

module vendor.blas;
needs { ffi };
use std.ffi;

@unsafe(invariant: "n matches the caller-allocated buffer length")
extern "c" fn dgemm(let n: i32, let a: rawptr[f64]);
