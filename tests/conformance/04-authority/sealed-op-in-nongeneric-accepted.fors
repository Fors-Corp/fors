//! name: sealed_op_in_nongeneric_accepted
//! rule: 04.R2a
//! expect: parse-ok
//! detail: accepted counterpart of sealed-op-in-generic-rejected.fors with call_ffi made non-generic
//! manifest:
//! [capabilities.ffi]
//! packages = ["std", "vendor"]

module vendor.blas;
needs { ffi };
use std.ffi;

fn call_ffi(let n: i32, let a: rawptr[f64]) {
    dgemm(n, a);
}

@unsafe(invariant: "n matches the caller-allocated buffer length")
extern "c" fn dgemm(let n: i32, let a: rawptr[f64]);
