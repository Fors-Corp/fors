//! name: reserved_kernel_as_member_access_reject
//! rule: 07.Grammar
//! expect: parse-error
//! detail: round 5 (D2) -- postfix "." ident needs an ident token; `kernel` is reserved, so `x.kernel` is a parse error even though a member name is not a name (ch08 R23)

module m;

fn f(let x: i32) -> i32 { return x.kernel; }
