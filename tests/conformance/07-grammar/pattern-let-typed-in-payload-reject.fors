//! name: pattern_let_typed_in_payload_rejected
//! rule: 07.D17
//! expect: parse-error
//! detail: "let x: T" is not a pattern inside a payload either; only the fpat form "x: pattern" has a colon and there "x" is a field name

module m;

enum Opt { Some(i32), None }

fn f(let p: Opt) -> i32 {
    match p {
        .Some(let n: i32) => n,
        .None => 0,
    }
}
