//! name: secret_raise_condition_rejected
//! rule: 05.R6b
//! expect: check-error
//! detail: a `raise` reached only through a secret-derived branch must be rejected; a secret-typed error payload raised unconditionally stays accepted -- ch05_secret_rules.rs's secret_raise_condition_rejected pins the IR side. Pending; see PENDING_05.

module secret_raise_condition_rejected;
needs { };

enum Err { boom }

fn raise_on_secret(let cond: secret bool) raises Err {
    if cond {
        raise Err.boom;
    }
}
