//! name: asm_secret_input_taints_outputs
//! rule: 05.R20a
//! expect: check-error
//! detail: an audited asm block with a secret `in` operand and a non-secret expected output type must fail (ch05 Rule 20a(a)); `@ct_audited`/secret-asm semantics are unimplemented, so this file is silent today; see PENDING_05.

module app;
needs { asm };

@unsafe(invariant: "x1 receives x0 verbatim")
fn taints(let s: secret i64) -> i64 {
    let r: i64 = asm(aarch64) {
        in(x0) = s,
        out(x1),
        "mov x1, x0",
    };
    return r;
}
