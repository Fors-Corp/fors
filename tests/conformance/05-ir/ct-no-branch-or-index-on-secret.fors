//! name: ct_no_branch_or_index_on_secret
//! rule: 05.R6b
//! expect: check-error
//! detail: a branch or an index derived from a secret value must be rejected at FMIR -- verify.rs's branch_on_secret_is_rejected and ch05_secret_rules.rs's ct_no_branch_or_index_on_secret pin the IR side. `fors check` does not implement ch05 yet, so this file is silent today; see PENDING_05.

module ct_no_branch_or_index_on_secret;
needs { };

fn leaky(let a: secret usize, let table: Slice[u64]) -> u64 {
    if a > 0 { return table[a]; }
    return 0;
}
