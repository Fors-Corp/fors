//! name: secret_propagates
//! rule: 05.R6a
//! expect: check-error
//! detail: the result of any op with a secret operand is secret; assigning it to a non-secret binding must be rejected -- verify.rs's secret_add_rejected_unless_result_marked_secret and ch05_secret_rules.rs's secret_propagates pin the IR side (marking `x` `secret u64` instead is the accepted form the same gate test asserts). Pending; see PENDING_05.

module secret_propagates;
needs { };

fn weakens(let s: secret u64) -> u64 {
    let x: u64 = s.wrap_add(1);
    return x;
}
