//! name: secret_trapping_op_rejected
//! rule: 05.R6b
//! expect: check-error
//! detail: plain (trapping) arithmetic on a secret operand hides a branch and must be rejected; use wrap_/sat_/unchecked_ instead -- verify.rs's secret_trapping_add_is_rejected_but_wrap_add_is_accepted and ch05_secret_rules.rs's secret_trapping_op_rejected pin the IR side. Pending; see PENDING_05.

module secret_trapping_op_rejected;
needs { };

fn trapping(let s: secret u64) -> secret u64 {
    return s + 1;
}
