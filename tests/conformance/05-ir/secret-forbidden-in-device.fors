//! name: secret_forbidden_in_device
//! rule: 05.R6b
//! expect: check-error
//! detail: "secret is forbidden inside @device/@tensor code" is ch05's own drafting decision (not yet a numbered Rule); cited against R6b's capability-boundary clause as the closest fit. This is the spec's own `bad_kernel` example. `@device` carries no checker semantics yet, so this file is silent today; see PENDING_05.

module secret_forbidden_in_device;
needs { };

@device
fn bad_kernel(let a: secret u64) -> secret u64 {
    return a;
}
