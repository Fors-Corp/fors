//! name: handler_binding_scope_rejected
//! rule: 08.R26
//! expect: check-error
//! detail: the handler binding e is in scope in the handler block only

module m;

struct Err {}
fn provider() -> i32 raises Err { return 1; }

fn f() -> i32 {
    let v: i32 = provider() else |e| { 0 };
    let w: Err = e;
    return v;
}
