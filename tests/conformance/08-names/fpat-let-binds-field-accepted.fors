//! name: fpat_let_binds_field_accepted
//! rule: 08.R25
//! expect: check-ok
//! detail: owner decision 2026-09-19 round 3 (D1) -- the fpat form "let x" uses x as both the field name and the bound name

module m;

struct P { pub x: i32, pub y: i32 }

fn f(let p: P) -> i32 {
    match p {
        P { let x, let y } => x + y,
    }
}
