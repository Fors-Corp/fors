//! name: pattern_prelude_value_reference_accepted
//! rule: 08.R25
//! expect: check-ok
//! detail: owner decision 2026-09-19 round 3 (D1) -- none is a prelude value, so both arms' `none` are references and may repeat; `some(let v)` has a payload and never binds `some`, only the "let v"/"let w" inside it bind

module m;

fn f(let a: Option[i32], let b: Option[i32]) -> i32 {
    match a {
        none => 0,
        some(let v) => match b {
            none => v,
            some(let w) => v + w,
        },
    }
}
