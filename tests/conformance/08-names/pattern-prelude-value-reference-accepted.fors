//! name: pattern_prelude_value_reference_accepted
//! rule: 08.R25
//! expect: check-ok
//! detail: none is a prelude value, so both arms' `none` are references and may repeat; `some(v)` has a payload and never binds `some`

module m;

fn f(let a: Option[i32], let b: Option[i32]) -> i32 {
    match a {
        none => 0,
        some(v) => match b {
            none => v,
            some(w) => v + w,
        },
    }
}
