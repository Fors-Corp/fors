//! name: prelude_usable_without_use_accepted
//! rule: 08.R17
//! expect: check-ok
//! detail: prelude types and values resolve with no use

module m;

fn f(let xs: Slice[u8], let a: Array[i32, 4], let flag: bool, let p: rawptr[u8]) -> Option[u64] {
    var total: u64 = 0;
    for x in xs { total = total.wrap_add(x as u64); }
    if flag { return none; }
    return some(total);
}
