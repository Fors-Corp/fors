//! name: same_method_in_two_impls_accepted
//! rule: 08.R27
//! expect: check-ok
//! detail: duplicates across different impl blocks, and a method sharing a field's name, are the checker's

module m;

struct S { get: i32 }

impl S {
    fn get(let self: Self) -> i32 { return 1; }
}

impl S {
    fn get(let self: Self) -> i32 { return 2; }
}
