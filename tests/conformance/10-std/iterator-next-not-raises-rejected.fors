//! name: iterator_next_not_raises_rejected
//! rule: 10.S32
//! expect: check-error
//! detail: S0032 -- `next` is TOTAL for every std iterator: it cannot be `raises`, so a failing source MUST NOT be modelled as an iterator

needs { };

enum Err { boom }

struct Src { n: usize }

impl Iterator for Src {
    type Item = i32;
    fn next(inout self) -> Option[i32] raises Err { return none; }
}
