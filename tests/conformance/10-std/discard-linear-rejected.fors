//! name: discard_linear_rejected
//! rule: 10.S11
//! expect: check-error
//! detail: ch01 R22d -- `discard` MUST NOT satisfy a linear obligation; only a move to a consumer does

needs { };

fn f(let n: i32) raises AllocError {
    with allocator a: PageAllocator {
        var b: Own[i64, a] = a.create(1)?;
        discard b;
    }
}
