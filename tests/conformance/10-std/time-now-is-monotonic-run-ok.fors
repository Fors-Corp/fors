//! name: time_now_is_monotonic
//! rule: 10.S45
//! expect: run-ok
//! detail: ok  -- now is monotonic and total: a later reading is never earlier (R45)

module app;
needs { clock, io.stdout };
use std.time, std.io;

fn main(let c: time.Clock, inout out: io.Stdout) {
    let a: time.Instant = c.now();
    let b: time.Instant = c.now();
    if a.nanos <= b.nanos {
        out.write_line("ok");
    } else {
        out.write_line("fail");
    }
}
