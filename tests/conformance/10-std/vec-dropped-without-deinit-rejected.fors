//! name: vec_dropped_without_deinit_rejected
//! rule: 10.S11
//! expect: check-error
//! detail: ch01 R22h -- a Vec is linear ALWAYS: it MUST be consumed by `Vec.deinit(&<allocator>)` on every path, including the `?`'s error exit

needs { };

fn leak(let n: i32) raises AllocError {
    with allocator a: PageAllocator {
        var v: Vec[i32, a] = Vec.new();
        v.push(&a, n)?;
    }
}
