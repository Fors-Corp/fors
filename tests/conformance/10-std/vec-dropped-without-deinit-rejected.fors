//! name: vec_dropped_without_deinit_rejected
//! rule: 10.S11
//! expect: check-error
//! detail: S0011 -- a Vec with capacity is linear: it MUST be consumed by deinit on every path

needs { };

fn leak(let n: i32) raises AllocError {
    with allocator a: PageAllocator {
        var v: Vec[i32, a] = Vec.new();
        v.push(&a, n)?;
    }
}
