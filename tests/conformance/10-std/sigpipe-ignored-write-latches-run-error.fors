//! name: sigpipe_ignored_write_latches_run_error
//! rule: 10.S40
//! expect: run-error
//! detail: status: 2  -- owner decision, Q8 (design §11.1): R40(d), ch02 R17: the entry shim installs `SIG_IGN` for `SIGPIPE`, so a write to a closed pipe latches an `io.Error.closed` instead of killing the process, and a latched `Stdout` error on an otherwise normal return is status 2 (ch10 R40(d)), not 0


module app;
needs { io.stdout };
use std.io;

fn main(inout out: io.Stdout) {
    out.write_line("to a closed pipe");
}
