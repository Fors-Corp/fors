//! name: vec_errdefer_normal_exit_unconsumed_rejected
//! rule: 10.S11
//! expect: check-error
//! detail: ch01 R22h -- an `errdefer` does not run on the normal exit, so this body leaves `v` unconsumed there

needs { };

fn f[A: brand, L: Allocator[A]](inout a: L) raises AllocError {
    var v: Vec[i32, A] = Vec.new();
    errdefer v.deinit(&a);
    v.push(&a, 1)?;
}
