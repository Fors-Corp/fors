//! name: linear_in_user_struct_inherits_rejected
//! rule: 10.S11
//! expect: check-error
//! detail: ch01 R22a(b) -- a user type that HOLDS a std linear type is linear BY INFERENCE, with nothing to declare

needs { };

struct Builder[A: brand] { out: Vec[i32, A], n: usize }

fn f[A: brand, L: Allocator[A]](inout a: L) {
    var b: Builder[A] = Builder { out: Vec.new(), n: 0 };
}
