//! name: linear_moved_to_caller_accepted
//! rule: 10.S11
//! expect: check-ok
//! detail: S0011 -- moving a linear value to a caller that consumes it satisfies the obligation

needs { };

fn make[A: brand, L: Allocator[A]](inout a: L, let n: i32) -> Vec[i32, A] raises AllocError {
    var v: Vec[i32, A] = Vec.new();
    v.push(&a, n)?;
    return v;
}
