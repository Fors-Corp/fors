//! name: adaptor_with_raising_closure_rejected
//! rule: 10.S8
//! expect: check-error
//! detail: T0038 -- S0008: a callable passed to a pure adaptor MUST NOT be raises; the fallible form is a try_ consumer

needs { };

fn f[I: Iterator](sink it: I, let g: fn (sink I.Item) -> i32 raises AllocError) -> usize {
    return it.map(g).count();   // a raising fn type never equals a non-raising one (ch09 R60)
}
