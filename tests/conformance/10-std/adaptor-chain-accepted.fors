//! name: adaptor_chain_accepted
//! rule: 10.S34
//! expect: check-ok
//! detail: S0034 -- adaptors are provided methods of Iterator taking `sink self`; the chain is one expression and stays scoped to `v` (ch01 R19c(a))

needs { };
use std.mem;

fn double(sink x: i32) -> i32 { return x * 2; }
fn small(let x: i32) -> bool { return x < 10; }

fn f[A: brand](let v: Vec[i32, A]) -> usize {
    return v.iter().map(double).filter(small).take(3).count();
}
