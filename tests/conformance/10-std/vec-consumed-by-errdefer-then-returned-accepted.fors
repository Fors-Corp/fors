//! name: vec_consumed_by_errdefer_then_returned_accepted
//! rule: 10.S11
//! expect: check-ok
//! detail: S0011, ch01 R23b -- `errdefer` discharges on the error paths only, leaving `return move v;` free to hand the value on

needs { };

fn build[A: brand, L: Allocator[A]](inout a: L) -> Vec[i32, A] raises AllocError {
    var v: Vec[i32, A] = Vec.new();
    errdefer v.deinit(&a);
    v.push(&a, 1)?;
    v.push(&a, 2)?;
    return move v;
}
