//! name: overlap_ignores_bounds_rejected
//! rule: 09.R19
//! expect: check-error
//! detail: T0019 -- bounds are ignored by the overlap test: there is no negative reasoning about which T have an Iterator impl

module m;

trait Tagged { fn tag(let self: Self) -> i64; }
struct Wrap[T] { inner: T }
impl[T: Iterator] Tagged for Wrap[T] { fn tag(let self: Wrap[T]) -> i64 { return 0; } }
impl[T: Copyable] Tagged for Wrap[T] { fn tag(let self: Wrap[T]) -> i64 { return 1; } }
