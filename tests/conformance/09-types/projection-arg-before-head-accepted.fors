//! name: projection_arg_before_head_accepted
//! rule: 09.R38
//! expect: check-ok
//! detail: `x` precedes the argument that binds I, so it is synthesised alone (7i64) and compared with the normalised I.Item in step (e)

module m;

struct Counter2 { n: i64, end: i64 }
impl Iterator for Counter2 {
    type Item = i64;
    fn next(inout self: Counter2) -> Option[i64] {
        if self.n >= self.end { return none; }
        self.n = self.n + 1;
        return some(self.n);
    }
}
fn seed[I: Iterator](let x: I.Item, sink it: I) -> i64 {
    discard it;
    return 0;
}
fn f(sink c: Counter2) -> i64 { return seed(7i64, move c); }
