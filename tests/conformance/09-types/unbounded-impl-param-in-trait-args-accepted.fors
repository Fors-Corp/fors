//! name: unbounded_impl_param_in_trait_args_accepted
//! rule: 09.R18
//! expect: check-ok
//! detail: an UNBOUNDED impl parameter may occur in the trait arguments alone

module m;

trait Conv[X] { fn conv(let self: Self) -> i64; }
struct Foo { n: i64 }
impl[U] Conv[U] for Foo {
    fn conv(let self: Foo) -> i64 { return self.n; }
}
