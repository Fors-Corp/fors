//! name: projection_on_concrete_head_rejected
//! rule: 09.R61
//! expect: check-error
//! detail: T0061 -- a projection headed by a concrete type is not writable: write i64

module m;

struct Counter2 { n: i64, end: i64 }
impl Iterator for Counter2 {
    type Item = i64;
    fn next(inout self: Counter2) -> Option[i64] {
        if self.n >= self.end { return none; }
        self.n = self.n + 1;
        return some(self.n);
    }
}
fn f(let x: Counter2.Item) { }
