//! name: for_element_type_mismatch_rejected
//! rule: 09.R31
//! expect: check-error
//! detail: T0026 -- x is Counter2.Item = i64; adding it to an i32 accumulator is a mismatch

module m;

struct Counter2 { n: i64, end: i64 }
impl Iterator for Counter2 {
    type Item = i64;
    fn next(inout self: Counter2) -> Option[i64] {
        if self.n >= self.end { return none; }
        self.n = self.n + 1;
        return some(self.n);
    }
}
fn f(sink c: Counter2) -> i32 {
    var total: i32 = 0;
    for x in c { total = total + x; }
    return total;
}
