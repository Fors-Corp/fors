//! name: implicit_receiver_move_accepted
//! rule: 09.R46
//! expect: check-ok
//! detail: `b.finish()` on a `sink self` method moves the place `b` with no marker (owner decision round 4)

module m;

struct Builder { parts: i64 }
impl Builder {
    fn finish(sink self: Builder) -> i64 {
        let p = self.parts;
        discard self;
        return p;
    }
    fn peek(let self: Builder) -> i64 { return self.parts; }
    fn add(inout self: Builder) { self.parts = self.parts + 1; }
}
fn f(sink b: Builder) -> i64 { return b.finish(); }
