//! name: neutral_projection_matches_generic_impl_accepted
//! rule: 09.R20
//! expect: check-ok
//! detail: Box[I.Item] with I rigid matches impl[T] Tagged for Box[T] with T := the neutral I.Item

module m;

trait Tagged { fn tag(let self: Self) -> i64; }
struct Box2[T] { v: T }
impl[T] Tagged for Box2[T] { fn tag(let self: Box2[T]) -> i64 { return 1; } }
fn g[I: Iterator](let b: Box2[I.Item]) -> i64 { return b.tag(); }
