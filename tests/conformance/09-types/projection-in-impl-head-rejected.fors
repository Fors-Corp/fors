//! name: projection_in_impl_head_rejected
//! rule: 09.R18
//! expect: check-error
//! detail: T0018 -- an impl head must not contain a projection, at any depth

module m;

trait Tagged { fn tag(let self) -> i64; }
struct Three[T] { a: T }
impl[I: Iterator] Tagged for Three[I.Item] {
    fn tag(let self: Three[I.Item]) -> i64 { return 0; }
}
