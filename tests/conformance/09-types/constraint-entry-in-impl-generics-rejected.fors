//! name: constraint_entry_in_impl_generics_rejected
//! rule: 09.R62
//! expect: check-error
//! detail: T0062 -- a constraint entry on an impl would make impl lookup recurse on a normalised projection

module m;

trait Tagged { fn tag(let self) -> i64; }
struct Wrap[T] { inner: T }
impl[T: Iterator, T.Item: Eq] Tagged for Wrap[T] {
    fn tag(let self: Wrap[T]) -> i64 { return 0; }
}
