//! name: provided_method_uses_foreign_op_rejected
//! rule: 09.R16
//! expect: check-error
//! detail: T0057 -- in a provided body Self is rigid and its only bound is the trait itself; `+` needs Add among the bounds

module m;

trait Shape {
    fn area(let self) -> f64;
    fn both(let self, let other: Self) -> Self { return self + other; }
}
