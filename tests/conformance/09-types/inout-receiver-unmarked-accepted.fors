//! name: inout_receiver_unmarked_accepted
//! rule: 09.R46
//! expect: check-ok
//! detail: an `inout self` receiver carries no `&` marker

module m;

struct Builder { parts: i64 }
impl Builder {
    fn finish(sink self: Builder) -> i64 {
        let p = self.parts;
        discard self;
        return p;
    }
    fn peek(let self: Builder) -> i64 { return self.parts; }
    fn add(inout self: Builder) { self.parts = self.parts + 1; }
}
fn f(inout b: Builder) { b.add(); }
