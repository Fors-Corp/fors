//! name: copyable_fieldwise_accepted
//! rule: 09.R23
//! expect: check-ok
//! detail: every field is Copyable, so the impl is accepted and a place of the type is copied

module m;

struct P { x: i32, y: i32 }
impl Copyable for P { }
fn f(let p: P) -> i32 {
    let a = p;
    let b = p;
    return a.x + b.y;
}
