//! name: param_only_under_projection_rejected
//! rule: 09.R39
//! expect: check-error
//! detail: T0039 -- I occurs only under a projection, which never binds; write g[Counter2](1)

module m;

struct Counter2 { n: i64, end: i64 }
impl Iterator for Counter2 {
    type Item = i64;
    fn next(inout self: Counter2) -> Option[i64] {
        if self.n >= self.end { return none; }
        self.n = self.n + 1;
        return some(self.n);
    }
}
fn g[I: Iterator](let x: I.Item) -> i64 { return 0; }
fn f() -> i64 { return g(1i64); }
