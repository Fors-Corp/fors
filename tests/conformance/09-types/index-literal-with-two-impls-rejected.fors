//! name: index_literal_with_two_impls_rejected
//! rule: 09.R29
//! expect: check-error
//! detail: T0029 -- with several Index impls the index is synthesised, and an unsuffixed literal index is rejected: suffix it

module m;

struct Grid { cells: Array[i64, 16], names: Array[Str, 4] }
impl Index[usize] for Grid {
    type Output = i64;
    fn at(let self: Grid, let i: usize) -> scoped(self) i64 { return self.cells[i]; }
}
impl Index[u8] for Grid {
    type Output = Str;
    fn at(let self: Grid, let i: u8) -> scoped(self) Str { return self.names[0]; }
}
fn f(let g: Grid) -> i64 { return g[0]; }
