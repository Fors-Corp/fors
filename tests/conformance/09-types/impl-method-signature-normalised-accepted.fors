//! name: impl_method_signature_normalised_accepted
//! rule: 09.R17
//! expect: check-ok
//! detail: the trait says Option[Self.Item]; the impl may write the normalised Option[i64]

module m;

struct Counter2 { n: i64, end: i64 }
impl Iterator for Counter2 {
    type Item = i64;
    fn next(inout self: Counter2) -> Option[i64] {
        if self.n >= self.end { return none; }
        self.n = self.n + 1;
        return some(self.n);
    }
}
