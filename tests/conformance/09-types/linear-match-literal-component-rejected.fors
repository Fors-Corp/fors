//! name: linear-match-literal-component-rejected
//! rule: 09.R50
//! expect: check-error
//! detail: ch01 R22d(ii) -- a literal pattern facing a linear component drops it

needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
}

enum Tagged { one(i32, Res) }

fn f(sink t: Tagged) {
    match t { .one(0, let r) => { r.close(); } _ => { } }
}
