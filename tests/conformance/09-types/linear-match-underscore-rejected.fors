needs { };

struct Res { fd: i32 }
impl Linear for Res { }
impl Res {
    fn open(let n: i32) -> Res { return Res { fd: n }; }
    fn close(sink self) { }
}

struct Box { r: Res }

fn f(sink b: Box) {
    match b { Box { r: _ } => { } }
}
