//! name: qualified_call_sink_receiver_needs_move_rejected
//! rule: 09.R46
//! expect: check-error
//! detail: ch01 R2 -- in the qualified form the receiver is an ordinary argument to a `sink` parameter and must be marked `move`

module m;

struct Builder { parts: i64 }
impl Builder {
    fn finish(sink self: Builder) -> i64 {
        let p = self.parts;
        discard self;
        return p;
    }
    fn peek(let self: Builder) -> i64 { return self.parts; }
    fn add(inout self: Builder) { self.parts = self.parts + 1; }
}
fn f(sink b: Builder) -> i64 { return Builder.finish(b); }
