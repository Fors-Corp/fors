// std.mem.seq — the slice iterator, the closed adaptor set and the closed
// consumer set. Surface: docs/spec/10-std.md Rules 28, 33-37. Bodies are
// STUBS. A leaf: imports nothing, so vec may import it.
//
// The Iterator trait itself is language-known (ch09 R21) and is NOT
// redeclared here, and there is no way to add a method to it (ch09 R43
// looks up inherent impls and trait impls only; there is no blanket impl,
// ch09 R18, and no free-function method syntax). Every adaptor and
// consumer is therefore a FREE FUNCTION, reached as `mem.map(...)`.
//
// An adaptor takes its source `inout` and returns a `scoped(it)` value:
// the result keeps the source borrowed for its whole life (ch01 R19a),
// which is how a scoped source (`v.iter()`, `mem.iter(s)`) may be adapted
// at all — a scoped value can be stored in no field, so an adaptor that
// took `sink it` and kept it in a struct would be rejected by ch01 R19a.
// A consumer takes `sink it`: it uses the iterator up and returns a plain
// value. A callable passed to an adaptor is never `raises` (R8): the
// fallible forms are the try_ consumers.
needs { };

// -------------------------------------------------------- the slice view

// A raw base and a length, NOT a Slice field (ch01 R19a). Yields copies.
pub struct SliceIter[T] { at: usize, n: usize, base: rawptr[T] }

impl[T: Copyable] Iterator for SliceIter[T] {
    type Item = T;
    fn next(inout self: Self) -> Option[Self.Item] {
        if self.at < self.n {
            self.at = self.at + 1;
            return self.load(self.at - 1);                   // STUB
        }
        return none;
    }
}

// The one iterator over borrowed storage, and the only unsafe step in
// every container's `iter` (R28, R33a): its scoped result keeps `s`, and
// so whatever `s` is scoped to, borrowed `let` for the iterator's life.
@unsafe(invariant: "base and n span s; the scoped result keeps s borrowed")
pub fn iter[T: Copyable](let s: Slice[T]) -> scoped(s) SliceIter[T] {
    return iter(s);                                          // STUB
}

// ------------------------------------------------------------- adaptors

// Each holds a raw pointer to its source, never the source: the source
// stays where it is, borrowed inout for the extent of the scoped result.
pub struct Mapped[I: Iterator, U] { src: rawptr[I], f: fn (let I.Item) -> U }
pub struct Filtered[I: Iterator] { src: rawptr[I], p: fn (let I.Item) -> bool }
pub struct Taken[I: Iterator] { src: rawptr[I], left: usize }
pub struct Skipped[I: Iterator] { src: rawptr[I], to_skip: usize }
pub struct Enumerated[I: Iterator] { src: rawptr[I], at: usize }
// The second source is OWNED (sink): ch01 R19 lets a result be scoped to
// one parameter only, so a zip of two borrowed iterators is not writable.
pub struct Zipped[I: Iterator, J: Iterator] { a: rawptr[I], b: J }

@unsafe(invariant: "src points at the argument for the extent of the scoped result")
pub fn map[I: Iterator, U](inout it: I, let f: fn (let I.Item) -> U) -> scoped(it) Mapped[I, U] {
    return map(&it, f);                                      // STUB
}

@unsafe(invariant: "src points at the argument for the extent of the scoped result")
pub fn filter[I: Iterator](inout it: I, let p: fn (let I.Item) -> bool) -> scoped(it) Filtered[I] {
    return filter(&it, p);                                   // STUB
}

@unsafe(invariant: "src points at the argument for the extent of the scoped result")
pub fn take[I: Iterator](inout it: I, let n: usize) -> scoped(it) Taken[I] {
    return take(&it, n);                                     // STUB
}

@unsafe(invariant: "src points at the argument for the extent of the scoped result")
pub fn skip[I: Iterator](inout it: I, let n: usize) -> scoped(it) Skipped[I] {
    return skip(&it, n);                                     // STUB
}

@unsafe(invariant: "src points at the argument for the extent of the scoped result")
pub fn enumerate[I: Iterator](inout it: I) -> scoped(it) Enumerated[I] {
    return enumerate(&it);                                   // STUB
}

@unsafe(invariant: "a points at the argument for the extent of the scoped result; b is owned")
pub fn zip[I: Iterator, J: Iterator](inout it: I, sink other: J) -> scoped(it) Zipped[I, J] {
    return zip(&it, move other);                             // STUB
}

// The private step through the raw pointer, one per adaptor: STUBS.
impl[I: Iterator, U] Mapped[I, U] {
    fn pull(inout self: Self) -> Option[I.Item] { return self.pull(); }       // STUB: (*src).next()
}
impl[I: Iterator] Filtered[I] {
    fn pull(inout self: Self) -> Option[I.Item] { return self.pull(); }       // STUB
}
impl[I: Iterator] Taken[I] {
    fn pull(inout self: Self) -> Option[I.Item] { return self.pull(); }       // STUB
}
impl[I: Iterator] Skipped[I] {
    fn pull(inout self: Self) -> Option[I.Item] { return self.pull(); }       // STUB
}
impl[I: Iterator] Enumerated[I] {
    fn pull(inout self: Self) -> Option[I.Item] { return self.pull(); }       // STUB
}
impl[I: Iterator, J: Iterator] Zipped[I, J] {
    fn pull(inout self: Self) -> Option[I.Item] { return self.pull(); }       // STUB
}

impl[I: Iterator, U] Iterator for Mapped[I, U] {
    type Item = U;
    fn next(inout self: Self) -> Option[Self.Item] {
        match self.pull() {
            some(let x) => { return some(self.f(x)); }
            none => { return none; }
        }
    }
}

impl[I: Iterator] Iterator for Filtered[I] {
    type Item = I.Item;
    fn next(inout self: Self) -> Option[Self.Item] {
        while true {
            match self.pull() {
                some(let x) => { if self.p(x) { return some(x); } }
                none => { return none; }
            }
        }
        return none;
    }
}

impl[I: Iterator] Iterator for Taken[I] {
    type Item = I.Item;
    fn next(inout self: Self) -> Option[Self.Item] {
        if self.left == 0 { return none; }
        self.left = self.left - 1;
        return self.pull();
    }
}

impl[I: Iterator] Iterator for Skipped[I] {
    type Item = I.Item;
    fn next(inout self: Self) -> Option[Self.Item] {
        while self.to_skip > 0 {
            self.to_skip = self.to_skip - 1;
            match self.pull() {
                some(let skipped) => { }
                none => { return none; }
            }
        }
        return self.pull();
    }
}

impl[I: Iterator] Iterator for Enumerated[I] {
    type Item = (usize, I.Item);
    fn next(inout self: Self) -> Option[Self.Item] {
        match self.pull() {
            some(let x) => { let i: usize = self.at; self.at = self.at + 1; return some((i, x)); }
            none => { return none; }
        }
    }
}

impl[I: Iterator, J: Iterator] Iterator for Zipped[I, J] {
    type Item = (I.Item, J.Item);
    fn next(inout self: Self) -> Option[Self.Item] {
        match self.pull() {
            some(let x) => {
                match self.b.next() {
                    some(let y) => { return some((x, y)); }
                    none => { return none; }
                }
            }
            none => { return none; }
        }
    }
}

// ------------------------------------------------------------ consumers

pub fn count[I: Iterator](sink it: I) -> usize {
    var n: usize = 0;
    for x in it { n = n + 1; }
    return n;
}

// Strictly left to right; never reassociated, whatever the algebra (R37).
pub fn fold[I: Iterator, B](sink it: I, sink init: B,
                            let f: fn (sink B, let I.Item) -> B) -> B {
    var acc: B = move init;
    for x in it { acc = f(move acc, x); }
    return acc;
}

pub fn for_each[I: Iterator](sink it: I, let f: fn (let I.Item)) {
    for x in it { f(x); }
}

pub fn all[I: Iterator](sink it: I, let p: fn (let I.Item) -> bool) -> bool {
    for x in it { if not p(x) { return false; } }
    return true;
}

pub fn any[I: Iterator](sink it: I, let p: fn (let I.Item) -> bool) -> bool {
    for x in it { if p(x) { return true; } }
    return false;
}

pub fn find[I: Iterator](sink it: I, let p: fn (let I.Item) -> bool) -> Option[I.Item] {
    for x in it { if p(x) { return some(x); } }
    return none;
}

// ------------------------------------------------- the try_ siblings (R8)

pub fn try_fold[I: Iterator, B, E](sink it: I, sink init: B,
                                   let f: fn (sink B, let I.Item) -> B raises E)
    -> B raises E
{
    var acc: B = move init;
    for x in it { acc = f(move acc, x)?; }
    return acc;
}

pub fn try_for_each[I: Iterator, E](sink it: I, let f: fn (let I.Item) raises E)
    raises E
{
    for x in it { f(x)?; }
}
