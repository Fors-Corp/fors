// std.mem.seq — the `Iterator` trait, the slice iterator, the closed
// adaptor set and the closed consumer set. Surface: docs/spec/10-std.md
// Rules 28, 32-37. Bodies are STUBS where storage is involved.
// A leaf: imports nothing, so vec may import it.
//
// Round 6 (owner decision 2026-09-20, O3). The adaptors and consumers are
// PROVIDED METHODS of `Iterator` (R34-R35), not free functions. The trait's
// REQUIRED part is language-known (ch09 R21) and this module declares that
// same trait: the prelude name `Iterator` and `mem.seq.Iterator` denote one
// item (ch08 R13's same-entity case). A provided method is a lookup
// candidate exactly like a required one (ch09 R16, R43), so `it.map(f)`
// resolves with NO blanket impl (ch09 R18 is untouched) — each adaptor is a
// concrete struct carrying its own struct-headed `impl Iterator`.
//
// An adaptor takes its source by value (`sink self`) and OWNS it; what
// makes that writable for a scoped source such as `v.iter()` is ch01 R19c:
// a call's result inherits its scoped argument's extent exactly when the
// declared result type mentions the parameter the argument went into.
// `by_ref` is the one borrowing adaptor and the one raw pointer left here.
//
// Two declaration shapes are forced and MUST NOT be "simplified" (R34):
// a callable parameter is a `fn` TYPE, never a callable type parameter
// (ch09 R38 never binds through a bound, so `U` would be uninferable), and
// an adaptor carries every parameter it needs in its own head (`Mapped[I,
// U]`, since ch09 R18 would leave `U` unconstrained otherwise). A callable
// FIELD is called as `(self.f)(move x)`, never `self.f(x)` (ch09 T0043).
needs { };

// ------------------------------------------------------------- the trait

pub trait Iterator {
    type Item: Droppable;
    fn next(inout self) -> Option[Self.Item];

    // ---- adaptors (R34): lazy, allocation-free, closed set ----

    // U: Droppable is forced by ch09 R17/R21: Mapped's `type Item = U;`
    // must satisfy `Item: Droppable` with U rigid, and the bound here makes
    // a closure returning a linear value fail at `map` (T0012).
    fn map[U: Droppable](sink self, let f: fn (sink Self.Item) -> U) -> Mapped[Self, U] {
        return Mapped { src: self, f: f };
    }

    fn filter(sink self, let p: fn (let Self.Item) -> bool) -> Filtered[Self] {
        return Filtered { src: self, p: p };
    }

    fn take(sink self, let n: usize) -> Taken[Self] {
        return Taken { src: self, left: n };
    }

    fn skip(sink self, let n: usize) -> Skipped[Self] {
        return Skipped { src: self, to_skip: n };
    }

    fn enumerate(sink self) -> Enumerated[Self] {
        return Enumerated { src: self, at: 0 };
    }

    fn zip[J: Iterator](sink self, sink other: J) -> Zipped[Self, J] {
        return Zipped { a: self, b: other };
    }

    // The one borrowing adaptor: how an `inout` iterator, or one held in a
    // field, is chained, since every other adaptor takes `sink self` and
    // ch01 R4a(c)-(d) forbid moving out of a field or an `inout` parameter.
    @unsafe(invariant: "src points at the receiver for the extent of the scoped result")
    fn by_ref(inout self) -> scoped(self) ByRef[Self] {
        return self.by_ref();                                // STUB
    }

    // ---- consumers (R35): each uses the iterator up ----

    fn count(sink self) -> usize {
        var n: usize = 0;
        for x in self { n = n + 1; }
        return n;
    }

    // Strictly left to right; never reassociated, whatever the algebra (R37).
    fn fold[B](sink self, sink init: B, let f: fn (sink B, sink Self.Item) -> B) -> B {
        var acc: B = move init;
        for x in self { acc = f(move acc, move x); }
        return acc;
    }

    fn for_each(sink self, let f: fn (sink Self.Item)) {
        for x in self { f(move x); }
    }

    fn all(sink self, let p: fn (let Self.Item) -> bool) -> bool {
        for x in self { if not p(x) { return false; } }
        return true;
    }

    fn any(sink self, let p: fn (let Self.Item) -> bool) -> bool {
        for x in self { if p(x) { return true; } }
        return false;
    }

    fn find(sink self, let p: fn (let Self.Item) -> bool) -> Option[Self.Item] {
        for x in self { if p(x) { return some(x); } }
        return none;
    }

    // The try_ siblings (R8): same name modulo the prefix, same order.
    fn try_fold[B, E](sink self, sink init: B,
                      let f: fn (sink B, sink Self.Item) -> B raises E) -> B raises E {
        var acc: B = move init;
        for x in self { acc = f(move acc, move x)?; }
        return acc;
    }

    fn try_for_each[E](sink self, let f: fn (sink Self.Item) raises E) raises E {
        for x in self { f(move x)?; }
    }
}

// -------------------------------------------------------- the slice view

// A raw base and a length, NOT a Slice field (ch01 R19a). Yields copies.
pub struct SliceIter[T] { at: usize, n: usize, base: rawptr[T] }

impl[T: Copyable] Iterator for SliceIter[T] {
    type Item = T;
    fn next(inout self) -> Option[Self.Item] {
        if self.at < self.n {
            self.at = self.at + 1;
            return self.load(self.at - 1);                   // STUB
        }
        return none;
    }
}

// The one iterator over borrowed storage, and the only free unsafe step in
// every container's `iter` (R28, R33a): its scoped result keeps `s`, and so
// whatever `s` is scoped to, borrowed `let` for the iterator's life.
@unsafe(invariant: "base and n span s; the scoped result keeps s borrowed")
pub fn iter[T: Copyable](let s: Slice[T]) -> scoped(s) SliceIter[T] {
    return iter(s);                                          // STUB
}

// ------------------------------------------------------------- adaptors

// Each OWNS its source (R34); only `ByRef` holds a raw pointer.
pub struct Mapped[I: Iterator, U: Droppable] { src: I, f: fn (sink I.Item) -> U }
pub struct Filtered[I: Iterator] { src: I, p: fn (let I.Item) -> bool }
pub struct Taken[I: Iterator] { src: I, left: usize }
pub struct Skipped[I: Iterator] { src: I, to_skip: usize }
pub struct Enumerated[I: Iterator] { src: I, at: usize }
// `zip` owns BOTH sources; a result with two scoped sources keeps both
// (ch01 R19c(d)) and is an ordinary local that ch01 R19 forbids returning.
pub struct Zipped[I: Iterator, J: Iterator] { a: I, b: J }
pub struct ByRef[I: Iterator] { src: rawptr[I] }

impl[I: Iterator, U: Droppable] Iterator for Mapped[I, U] {
    type Item = U;
    fn next(inout self) -> Option[U] {
        match self.src.next() {
            some(let x) => { return some((self.f)(move x)); }
            none => { return none; }
        }
    }
}

impl[I: Iterator] Iterator for Filtered[I] {
    type Item = I.Item;
    fn next(inout self) -> Option[I.Item] {
        while true {
            match self.src.next() {
                some(let x) => { if (self.p)(x) { return some(x); } }
                none => { return none; }
            }
        }
        return none;
    }
}

impl[I: Iterator] Iterator for Taken[I] {
    type Item = I.Item;
    fn next(inout self) -> Option[I.Item] {
        if self.left == 0 { return none; }
        self.left = self.left - 1;
        return self.src.next();
    }
}

impl[I: Iterator] Iterator for Skipped[I] {
    type Item = I.Item;
    fn next(inout self) -> Option[I.Item] {
        while self.to_skip > 0 {
            self.to_skip = self.to_skip - 1;
            match self.src.next() {
                some(let skipped) => { }
                none => { return none; }
            }
        }
        return self.src.next();
    }
}

impl[I: Iterator] Iterator for Enumerated[I] {
    type Item = (usize, I.Item);
    fn next(inout self) -> Option[Self.Item] {
        match self.src.next() {
            some(let x) => { let i: usize = self.at; self.at = self.at + 1; return some((i, x)); }
            none => { return none; }
        }
    }
}

impl[I: Iterator, J: Iterator] Iterator for Zipped[I, J] {
    type Item = (I.Item, J.Item);
    fn next(inout self) -> Option[Self.Item] {
        match self.a.next() {
            some(let x) => {
                match self.b.next() {
                    some(let y) => { return some((x, y)); }
                    none => { return none; }
                }
            }
            none => { return none; }
        }
    }
}

impl[I: Iterator] Iterator for ByRef[I] {
    type Item = I.Item;
    fn next(inout self) -> Option[I.Item] {
        return self.pull();                                  // STUB: (*src).next()
    }
}

impl[I: Iterator] ByRef[I] {
    fn pull(inout self) -> Option[I.Item] { return self.pull(); }   // STUB
}
