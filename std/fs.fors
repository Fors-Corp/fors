// std.fs — the rooted directory capability.
// Surface: docs/spec/10-std.md Rules 41-42. F8: `Dir`'s bodies are real
// (name validation, then the host door); the rest are STUBS.
//
// Every operation names a single directory ENTRY, never a path: no `/`, no
// NUL, not `.`, not `..`, non-empty, checked BEFORE any syscall. Traversal
// is repeated open_dir, which ch04 R7 requires to be downward-only, so no
// string can widen the capability a program holds. There is no ambient
// current directory and no Path type.
needs { syscall };

use std.io;

pub enum Error {
    not_found,
    exists,
    permission,
    invalid_name,
    is_dir,
    not_dir,
    no_space,
    would_block,
    interrupted,
    other
}

pub enum Kind { file, dir, other }

pub struct Meta { pub len: u64, pub kind: Kind, pub modified_unix_nanos: i64 }

// Root-capability type (ch04 R21), paired with fs.read or fs.write. Each
// operation still needs its own capability (ch04 R1): holding a Dir grants
// neither by itself.
pub struct Dir { fd: i32 }

impl Dir {
    // F8: every name-taking operation validates its entry name FIRST, in
    // Fors, with no host call (R41: "a violation raises Error.invalid_name
    // BEFORE any syscall"), and only then reaches the host door. The M1
    // host performs no file-system syscall at all: reaching `fs_door` is
    // the interpreter's NAMED refusal (never a silent stub error), and the
    // host's `fs_syscalls` counter proves a rejected name never got there.

    // Downward-only (ch04 R7): a subdirectory of the receiver, never a
    // sibling or an ancestor, and never through a symlink that leaves it.
    pub fn open_dir(let self: Self, let name: Str) -> Dir raises Error {
        check_name(name)?;
        self.fs_door("open_dir");
        raise Error.other; // unreachable: the M1 door never returns
    }

    pub fn read_into(let self: Self, let name: Str, inout into: Slice[u8]) -> usize raises Error {
        check_name(name)?;
        self.fs_door("read_into");
        raise Error.other; // unreachable: the M1 door never returns
    }

    pub fn write_all(let self: Self, let name: Str, let bytes: Slice[u8]) raises Error {
        check_name(name)?;
        self.fs_door("write_all");
        raise Error.other; // unreachable: the M1 door never returns
    }

    pub fn open(let self: Self, let name: Str) -> File raises Error {
        check_name(name)?;
        self.fs_door("open");
        raise Error.other; // unreachable: the M1 door never returns
    }

    pub fn create(let self: Self, let name: Str) -> File raises Error {
        check_name(name)?;
        self.fs_door("create");
        raise Error.other; // unreachable: the M1 door never returns
    }

    pub fn metadata(let self: Self, let name: Str) -> Meta raises Error {
        check_name(name)?;
        self.fs_door("metadata");
        raise Error.other; // unreachable: the M1 door never returns
    }

    pub fn remove(let self: Self, let name: Str) raises Error {
        check_name(name)?;
        self.fs_door("remove");
        raise Error.other; // unreachable: the M1 door never returns
    }

    pub fn rename(let self: Self, let from: Str, let to: Str) raises Error {
        check_name(from)?;
        check_name(to)?;
        self.fs_door("rename");
        raise Error.other; // unreachable: the M1 door never returns
    }

    pub fn entries(let self: Self) -> Entries raises Error {
        self.fs_door("entries");
        raise Error.other; // unreachable: the M1 door never returns
    }

    // The host door: lowering intercepts a method literally spelled this ON
    // THIS IMPL (`std.fs.Dir`, ch04 R21) whose body is this self-recursive
    // stand-in (same shape as `Str.str_byte_len`). `op` names the operation
    // in the interpreter's refusal.
    fn fs_door(let self: Self, let op: Str) {
        self.fs_door(op);
    }
}

// R41's entry-name rule, checked before any syscall: non-empty, no `/`
// (47), no NUL (0), and neither `.` nor `..` (46). Pure Fors over `Str`'s
// byte reader; it never reaches the host.
fn check_name(let name: Str) raises Error {
    let n: usize = name.len();
    if n == 0 {
        raise Error.invalid_name;
    }
    if n <= 2 and name.at(0) == 46 and name.at(n - 1) == 46 {
        raise Error.invalid_name;
    }
    for i in 0..<n {
        let b: u8 = name.at(i);
        if b == 47 or b == 0 {
            raise Error.invalid_name;
        }
    }
}

// Linear (R11): close is the only release.
pub struct File { fd: i32 }

// Round 6 (R11, ch01 R22): linear — consumed by `close` on every path.
impl Linear for File {}

impl File {
    pub fn read_into(inout self: Self, inout into: Slice[u8]) -> usize raises Error {
        raise Error.would_block; // STUB
    }
    pub fn write_all(inout self: Self, let bytes: Slice[u8]) raises Error {
        raise Error.no_space; // STUB
    }
    pub fn len(let self: Self) -> u64 raises Error {
        raise Error.other;
    } // STUB
    pub fn close(sink self: Self) raises Error {} // STUB
}

// Orphan rule (ch08 R21): foreign trait, local type.
impl io.Reader for File {
    fn read(inout self: Self, inout into: Slice[u8]) -> usize raises io.Error {
        raise io.Error.closed; // STUB
    }
}

impl io.Writer for File {
    fn write(inout self: Self, let bytes: Slice[u8]) -> usize raises io.Error {
        raise io.Error.closed; // STUB
    }
    fn write_all(inout self: Self, let bytes: Slice[u8]) raises io.Error {
        raise io.Error.closed; // STUB
    }
    fn flush(inout self: Self) raises io.Error {} // STUB
}

// NOT an Iterator: its item would have to borrow a name buffer (R10d), so
// it takes one. Linear.
pub struct Entries { fd: i32, at: u64 }

// Round 6 (R11, ch01 R22): linear — consumed by `close` on every path.
impl Linear for Entries {}

impl Entries {
    pub fn next_into(inout self: Self, inout name: Slice[u8]) -> Option[Meta] raises Error {
        raise Error.other; // STUB
    }
    pub fn close(sink self: Self) {} // STUB
}

// COMPTIME-ONLY (R42) — there is no `comptime fn` in the grammar
// (`comptime` introduces a BLOCK, ch07), so the restriction is ch10 R42's
// rule, not a modifier: a call outside a `comptime` block is a compile
// error. `path` must be a comptime constant listed in the caller module's
// `inputs { ... };` clause (ch04 R13). No capability, and TOTAL — a missing
// input is a BUILD error, which is why the corpus writes it with no `?`.
pub fn read_to_string(let path: Str) -> Str {
    return input_read(path);
}

// The comptime door (design §5.8's `@input_read` row, F9). Lowering
// intercepts a call to this function of THIS module whose body is this
// self-recursive stand-in and emits the `input_read` intrinsic, which
// serves the bytes from the build's declared-inputs map and is forbidden
// at run time — never a descriptor, never the file system.
fn input_read(let path: Str) -> Str {
    return input_read(path);
}
