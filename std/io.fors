// std.io — the standard streams and the two byte traits.
// Surface: docs/spec/10-std.md Rules 39-40. Bodies are STUBS.
//
// The five write_* methods on Stdout/Stderr are TOTAL and LATCHING: a
// failure sets a sticky flag and `check` (or the trait's `flush`) surfaces
// it. This is the only place std records a failure instead of returning
// one; the fallible surface is the Writer trait.
needs { syscall };

pub enum Error { closed, would_block, interrupted, no_space, invalid_utf8, other }

pub trait Writer {
    fn write(inout self: Self, let bytes: Slice[u8]) -> usize raises Error;
    fn write_all(inout self: Self, let bytes: Slice[u8]) raises Error;
    fn flush(inout self: Self) raises Error;
}

pub trait Reader {
    fn read(inout self: Self, inout into: Slice[u8]) -> usize raises Error;
}

// Root-capability types (ch04 R7-8, R21): opaque, constructorless, not
// Copyable, reachable only as a `main` parameter or handed down.
// Block-buffered at IO_BUF_BYTES = 8192, line-buffered on a terminal.
pub struct Stdout { fd: i32, latched: Option[Error], n: usize, buf: Array[u8, 8192] }

// UNBUFFERED, so a diagnostic is on the descriptor before the next
// statement runs — and therefore survives a trap (R40).
pub struct Stderr { fd: i32, latched: Option[Error] }

pub struct Stdin { fd: i32 }

impl Stdout {
    pub fn write_line(inout self: Self, let s: Str) {} // STUB, total
    pub fn write_str(inout self: Self, let s: Str) {} // STUB, total
    pub fn write_int(inout self: Self, let v: i64) {} // STUB, base 10, no locale
    pub fn write_uint(inout self: Self, let v: u64) {} // STUB, base 10, no locale
    pub fn write_bytes(inout self: Self, let b: Slice[u8]) {} // STUB, total

    // Surface a latched error (R39).
    pub fn check(inout self: Self) raises Error {
        match self.latched {
            some(let e) => {
                raise e;
            }
            none => {}
        }
    }

    pub fn clear_error(inout self: Self) {
        self.latched = none;
    }
}

impl Stderr {
    pub fn write_line(inout self: Self, let s: Str) {} // STUB, total
    pub fn write_str(inout self: Self, let s: Str) {} // STUB, total
    pub fn write_int(inout self: Self, let v: i64) {} // STUB, total
    pub fn write_uint(inout self: Self, let v: u64) {} // STUB, total
    pub fn write_bytes(inout self: Self, let b: Slice[u8]) {} // STUB, total

    pub fn check(inout self: Self) raises Error {
        match self.latched {
            some(let e) => {
                raise e;
            }
            none => {}
        }
    }

    pub fn clear_error(inout self: Self) {
        self.latched = none;
    }
}

impl Stdin {
    // none at end of input; Error.no_space if the line does not fit.
    pub fn read_line_into(inout self: Self, inout into: Slice[u8]) -> Option[usize] raises Error {
        raise Error.closed; // STUB
    }
}

// The FALLIBLE surface. Every generic (`T: io.Writer`) and `dyn io.Writer`
// use goes through these; the trait is never a root-capability type.
impl Writer for Stdout {
    fn write(inout self: Self, let bytes: Slice[u8]) -> usize raises Error {
        raise Error.closed;
    } // STUB
    fn write_all(inout self: Self, let bytes: Slice[u8]) raises Error {
        raise Error.closed;
    } // STUB
    fn flush(inout self: Self) raises Error {
        raise Error.closed;
    } // STUB
}

impl Writer for Stderr {
    fn write(inout self: Self, let bytes: Slice[u8]) -> usize raises Error {
        raise Error.closed;
    } // STUB
    fn write_all(inout self: Self, let bytes: Slice[u8]) raises Error {
        raise Error.closed;
    } // STUB
    fn flush(inout self: Self) raises Error {} // unbuffered
}

impl Reader for Stdin {
    fn read(inout self: Self, inout into: Slice[u8]) -> usize raises Error {
        raise Error.closed;
    } // STUB
}
