// std.env — the environment and the argument vector. Every read takes the
// capability value; nothing is ambient. No mutation (R10l), no locale (R56).
// Surface: docs/spec/10-std.md Rule 46. Bodies are STUBS.
needs { syscall };

pub enum Error { too_large, invalid_utf8, other }

// Root-capability types (ch04 R21), both paired with the `env` capability.
pub struct Env { }
pub struct Args { }

impl Env {
    pub fn has(let self: Self, let name: Str) -> bool { return false; }        // STUB

    // Caller-buffer form: a growing variant would need an allocator.
    // `none` = not set (a fact, R6c); Error.too_large = the buffer was too
    // small (a cause).
    pub fn get_into(let self: Self, let name: Str, inout into: Slice[u8])
        -> Option[usize] raises Error
    {
        raise Error.other;                                                     // STUB
    }
}

impl Args {
    pub fn len(let self: Self) -> usize { return 0; }                          // STUB
    // at(0) is the program name as the operating system gave it.
    pub fn at(let self: Self, let i: usize) -> Option[Str] { return none; }    // STUB
}
