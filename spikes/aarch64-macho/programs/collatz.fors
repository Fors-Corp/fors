fn chain_len(let start: i64) -> i64 {
    var n: i64 = start;
    var steps: i64 = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

fn main(inout out: io.Stdout) raises io.Error {
    var best_start: i64 = 1;
    var best_len: i64 = 0;
    var i: i64 = 1;
    while i < 100000 {
        var len: i64 = chain_len(i);
        if len > best_len {
            best_len = len;
            best_start = i;
        }
        i = i + 1;
    }
    out.write_int(best_start)?;
    out.write_int(best_len)?;
}
