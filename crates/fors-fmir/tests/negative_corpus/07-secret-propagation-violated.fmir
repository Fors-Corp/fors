//! name: secret-propagation-violated
//! expect: verify-reject
//! code: SecretPropagationViolated
// ch05 Rule 6a: the result of an op with a secret operand must be secret
// too. `wrap` mode is used so this case does not ALSO trip
// SecretTrappingOp -- that is a separate corpus entry.

decl 7 sig 1
block bb0
val %s = param 0 ty 1 secret ct=0
val %one = param 1 ty 1 nosecret ct=0
val %r = add:wrap %s %one ty 1 nosecret ct=0
do unreachable
