//! name: index-derived-from-secret
//! expect: verify-reject
//! code: SecretBranchOrIndex
// ch05 Rule 6b: an index derived from secret. A seed is given so this
// entry does not also trip MemoryOpMissingAliasSeed.

decl 9 sig 1
block bb0
val %base = param 0 ty 1 nosecret ct=0
val %idx = param 1 ty 1 secret ct=0
val %v = index %base %idx ty 1 nosecret ct=0 seed conv-let
do unreachable
