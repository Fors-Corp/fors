//! name: secret-trapping-op-rejected
//! expect: verify-reject
//! code: SecretTrappingOp
// ch05 Rule 6b: plain (trapping) arithmetic on a secret operand; use
// wrap_/sat_/unchecked_ instead.

decl 10 sig 1
block bb0
val %s = param 0 ty 1 secret ct=0
val %one = param 1 ty 1 nosecret ct=0
do add %s %one
do unreachable
